<Application x:Class="CastBridge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CastBridge.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- A small self-contained dark theme. Standard WPF controls only: the app has to look
                 right on any machine without a theme package getting in the way. -->
            <SolidColorBrush x:Key="Window.Background" Color="#FF16181D" />
            <SolidColorBrush x:Key="Panel.Background" Color="#FF1F232B" />
            <SolidColorBrush x:Key="Accent" Color="#FF4C8DFF" />
            <SolidColorBrush x:Key="Text.Primary" Color="#FFEDEFF3" />
            <SolidColorBrush x:Key="Text.Muted" Color="#FF9AA3B2" />
            <SolidColorBrush x:Key="Border.Subtle" Color="#FF2E333D" />

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:BooleanToInverseVisibilityConverter x:Key="BooleanToInverseVisibilityConverter" />
            <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />

            <Style x:Key="Heading" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
            </Style>

            <!-- No implicit TextBlock style on purpose. An implicit style applies to every TextBlock
                 in the process, including the ones WPF puts inside the tray menu and tooltips, and it
                 beats whatever those inherit: the menu's items came out near-white on the system's
                 white menu background, which is to say invisible. Each window now sets
                 TextElement.Foreground on its own root instead, which is inherited by exactly the
                 content that belongs to it, and menus and tooltips keep the system's own colours. -->

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Panel.Background}" />
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Slider">
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            </Style>

            <Style TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="Background" Value="{StaticResource Border.Subtle}" />
                <Setter Property="Height" Value="3" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
