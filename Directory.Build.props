<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- CA1416: platform checks are noisy for a Windows-only app. -->
    <NoWarn>$(NoWarn);CA1416;CA1848;CA2007;CA1031;CA1062;CA1303;CA1305;CA1819;CA1859;CA1002</NoWarn>
    <Version>0.1.0</Version>
    <Authors>CastBridge</Authors>
    <Product>CastBridge</Product>
  </PropertyGroup>
</Project>
